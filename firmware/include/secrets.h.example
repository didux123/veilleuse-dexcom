// WiFi : OPTIONNEL. Sert seulement de valeur initiale au premier flash.
// Sinon, laisser vide ("") : la veilleuse emettra le reseau
// "Veilleuse-Dexcom" (LEDs violettes) -> s'y connecter au telephone
// et choisir son WiFi dans le portail qui s'ouvre.
#define WIFI_SSID       ""
#define WIFI_PASSWORD   ""

// Compte Dexcom qui PUBLIE (celui de l'app G7, pas un follower).
// Le partage doit etre actif avec au moins 1 follower.
#define DEXCOM_USERNAME "email@exemple.com"
#define DEXCOM_PASSWORD "motdepassedexcom"

// Mot de passe des mises a jour OTA (doit correspondre au --auth de
// platformio.ini, env d1_mini_ota). Optionnel : defaut "veilleuse".
#define OTA_PASSWORD    "veilleuse"

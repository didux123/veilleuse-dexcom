// Copier ce fichier en secrets.h (gitignore).
//
// EN PRODUCTION, TOUT PEUT RESTER VIDE : la lampe se configure entierement
// depuis son portail captif (WiFi + compte Dexcom + seuils), et la config
// est stockee dans sa memoire flash. Ces constantes ne servent qu'au
// developpement, pour eviter de repasser par le portail a chaque flash.
#pragma once

// WiFi de developpement (optionnel) : sert de reseau initial au premier
// flash. Sinon, la lampe emet "Veilleuse-XXXX" (LEDs violettes) et on
// choisit son reseau depuis un telephone.
#define WIFI_SSID       ""
#define WIFI_PASSWORD   ""

// Compte Dexcom de developpement (optionnel). En production, l'utilisateur
// saisit les siens dans le portail ; ils sont alors prioritaires sur ceux-ci.
// Doit etre le compte qui PUBLIE (celui de l'app G7, pas un follower), avec
// le partage actif et au moins un follower invite.
#define DEXCOM_USERNAME ""
#define DEXCOM_PASSWORD ""

// Mot de passe des mises a jour OTA locales (doit correspondre au --auth de
// platformio.ini, env d1_mini_ota). Optionnel : defaut "veilleuse".
#define OTA_PASSWORD    "veilleuse"

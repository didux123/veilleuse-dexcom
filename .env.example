# Identifiants du compte Dexcom qui PUBLIE les données (pas ceux d'un follower).
# Username legacy, email, ou numéro de téléphone au format +33...
DEXCOM_USERNAME=
DEXCOM_PASSWORD=

# Région : "ous" pour Europe / hors États-Unis, "us" pour les États-Unis
DEXCOM_REGION=ous

# Port du serveur web (optionnel, défaut 3000)
PORT=3000
